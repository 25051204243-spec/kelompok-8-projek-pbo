# abstraksi dan pholi
class MetodePembayaran(ABC):
    def __init__(self, nama):
        self._nama = nama  # Protected Attribute

    @abstractmethod
    def hitung_transaksi(self, total_tagihan):
        pass


class BayarTunai(MetodePembayaran):
    def __init__(self):
        super().__init__("TUNAI")

    def hitung_transaksi(self, total_tagihan):
        uang_diterima = float(math.ceil(total_tagihan / 5.0) * 5.0)
        if uang_diterima == 0: uang_diterima = 5.0
        uang_kembalian = uang_diterima - total_tagihan
        return uang_diterima, uang_kembalian


class BayarNonTunai(MetodePembayaran):
    def __init__(self):
        super().__init__("NON-TUNAI")

    def hitung_transaksi(self, total_tagihan):
        return total_tagihan, 0.0


