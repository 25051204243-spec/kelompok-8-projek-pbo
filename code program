def muat_gambar(nama_file, ukuran=None):
    try:
        img = pygame.image.load(nama_file).convert_alpha()
        if ukuran:
            return pygame.transform.scale(img, ukuran)
        return img
    except pygame.error:
        print(f"[SISTEM] Gambar '{nama_file}' tidak ditemukan. Menggunakan fallback surface.")
        permukaan = pygame.Surface(ukuran if ukuran else (50, 50), pygame.SRCALPHA)
        if "soda" in nama_file:
            permukaan.fill((255, 0, 0, 150))
        elif "roti" in nama_file:
            permukaan.fill((200, 100, 0, 150))
        elif "susu" in nama_file:
            permukaan.fill((0, 0, 255, 150))
        else:
            permukaan.fill((200, 200, 200, 250))
        return permukaan


def muat_audio(nama_file):
    try:
        return pygame.mixer.Sound(nama_file)
    except pygame.error:
        print(f"[SISTEM] Audio '{nama_file}' tidak ditemukan. Suara dinonaktifkan.")
        return None


def putar_backsound(nama_file, volume=0.3):
    try:
        pygame.mixer.music.load(nama_file)
        pygame.mixer.music.set_volume(volume)
        pygame.mixer.music.play(-1)
    except pygame.error:
        print(f"[SISTEM] Backsound '{nama_file}' tidak ditemukan.")


